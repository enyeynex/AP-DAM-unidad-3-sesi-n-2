# Guía 14: el equipo de firma lo elige cada quien en Xcode (Signing & Capabilities).
TEAM_ID=

PRODUCT_NAME=PharmaMobil
# Guía 14: el mismo identificador que la app Android, sin sufijos del equipo.
PRODUCT_BUNDLE_IDENTIFIER=pe.edu.upeu.pharmamobil

# Guía 14: versión de entrega, igual que Android (versionName 1.0.0, versionCode 1).
CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0.0
# SQLDelight (sesion 11): el framework Shared es estatico y el driver nativo
# necesita la libreria SQLite del sistema al enlazar la app.
OTHER_LDFLAGS = $(inherited) -lsqlite3
