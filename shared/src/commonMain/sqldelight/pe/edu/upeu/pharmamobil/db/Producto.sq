-- Copia local del inventario. Es la unica fuente de verdad de la pantalla:
-- la red solo la mantiene al dia (sesion 11, offline-first).
CREATE TABLE producto (
    id        INTEGER NOT NULL PRIMARY KEY,
    nombre    TEXT    NOT NULL,
    precio    REAL    NOT NULL,
    stock     INTEGER NOT NULL,
    pendiente INTEGER NOT NULL DEFAULT 0,
    -- Motivo por el que PharmaSoft rechazo el pendiente (409, validacion).
    -- Un rechazado no se reintenta solo: el usuario lo descarta.
    rechazo   TEXT,
    -- Guía 13: cuántas veces se intentó enviar la fila sin éxito por un fallo
    -- transitorio (sin red, tiempo agotado, servicio no disponible) y cuál fue
    -- el último. Con intentos >= máximo la fila queda «fallida» y visible.
    intentos    INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT
);

listarTodos:
SELECT * FROM producto ORDER BY nombre ASC;

listarPendientes:
SELECT * FROM producto WHERE pendiente = 1 AND rechazo IS NULL;

buscarPorId:
SELECT * FROM producto WHERE id = ?;

-- INSERT OR REPLACE reescribe la fila completa: intentos, ultimoError y
-- rechazo vuelven a sus valores por defecto.
insertar:
INSERT OR REPLACE INTO producto (id, nombre, precio, stock, pendiente)
VALUES (?, ?, ?, ?, ?);

pendientesPorEnviar:
SELECT * FROM producto
WHERE pendiente = 1 AND rechazo IS NULL AND intentos < :maxIntentos
ORDER BY id DESC;

contarPendientes:
SELECT COUNT(*) FROM producto
WHERE pendiente = 1 AND rechazo IS NULL AND intentos < :maxIntentos;

contarFallidas:
SELECT COUNT(*) FROM producto
WHERE pendiente = 1 AND (rechazo IS NOT NULL OR intentos >= :maxIntentos);

sumarIntento:
UPDATE producto SET intentos = intentos + 1, ultimoError = ? WHERE id = ?;

reiniciarIntentos:
-- «Reintentar ahora» lo decide el usuario: las filas fallidas (por agotar
-- intentos o por un rechazo, por ejemplo una sesión vencida) vuelven a la cola.
UPDATE producto SET intentos = 0, ultimoError = NULL, rechazo = NULL
WHERE pendiente = 1 AND (rechazo IS NOT NULL OR intentos >= :maxIntentos);

marcarRechazado:
UPDATE producto SET rechazo = ? WHERE id = ?;

descartarPendiente:
DELETE FROM producto WHERE id = ? AND pendiente = 1;

borrarPorId:
DELETE FROM producto WHERE id = ?;

borrarSincronizados:
DELETE FROM producto WHERE pendiente = 0;

siguienteIdLocal:
-- COALESCE evita el NULL de la tabla vacia; el minOf de Kotlin
-- garantiza que el id resultante sea siempre negativo.
SELECT COALESCE(MIN(id), 0) FROM producto;
